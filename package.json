{
  "name": "advanced-imessage-monorepo",
  "version": "2.0.0",
  "description": "Monorepo for the Advanced iMessage TypeScript SDK",
  "author": "Photon",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/photon-hq/advanced-imessage-ts.git"
  },
  "bugs": {
    "url": "https://github.com/photon-hq/advanced-imessage-ts/issues"
  },
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=18.17"
  },
  "scripts": {
    "generate": "PATH=./node_modules/.bin:$PATH buf generate",
    "generate:http": "openapi-ts -i gen/openapi/imessage.swagger.json -o packages/http/src/generated/http -c @hey-api/client-fetch",
    "build": "bun run generate && bun run --cwd packages/advanced-imessage build",
    "check": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --fix .",
    "test": "bun test packages",
    "test:unit": "bun test packages"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.7",
    "@bufbuild/buf": "^1.50.0",
    "@bufbuild/protobuf": "^2.11.0",
    "@grpc/grpc-js": "^1.12.6",
    "@hey-api/openapi-ts": "^0.99.0",
    "@types/bun": "latest",
    "nice-grpc": "^2.1.11",
    "nice-grpc-common": "^2.0.3",
    "ts-proto": "^2.6.1",
    "tsup": "^8.4.0",
    "typescript": "^5.7.0",
    "ultracite": "7.3.2",
    "wrangler": "^4.110.0"
  }
}
