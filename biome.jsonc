{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "extends": ["ultracite/biome/core"],
  "files": {
    // gen/ holds buf-generated artifacts (OpenAPI spec); formatting them
    // creates permanent churn against `buf generate` output.
    "includes": ["!!bun.lock", "!gen"]
  },
  "overrides": [
    {
      "includes": ["tests/**"],
      "linter": {
        "rules": {
          "suspicious": {
            "useAwait": "off"
          }
        }
      }
    }
  ]
}
