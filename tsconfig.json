{
  "compilerOptions": {
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "target": "ES2022",
    "module": "ESNext",
    "moduleDetection": "force",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "strict": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "exactOptionalPropertyTypes": false,
    "baseUrl": ".",
    "paths": {
      "@photon-ai/aim-core": ["packages/core/src/index.ts"],
      "@photon-ai/aim-core/internal": ["packages/core/src/internal.ts"],
      "@photon-ai/aim-core/generated/*": ["packages/core/src/generated/*.ts"],
      "@photon-ai/aim-http": ["packages/http/src/index.ts"],
      "@photon-ai/aim-grpc": ["packages/grpc/src/index.ts"]
    }
  },
  "include": ["packages/*/src", "packages/*/tests", "tests"],
  "exclude": [
    "node_modules",
    "dist",
    "packages/*/dist",
    "packages/core/src/generated",
    "packages/http/src/generated"
  ]
}
